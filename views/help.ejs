<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { pageTitle: 'Help & Support | Sutton Security Systems', pageDesc: 'Get help with your Sutton Ajax alarm system. Speak directly to your installer, browse common questions or contact us by phone, email or WhatsApp.' }) %>
</head>
<body class="bg-white">
  <%- include('partials/header') %>

  <main>
    <!-- Page hero -->
    <section class="bg-gray-50 border-b border-black/5">
      <div class="container-x py-14 sm:py-16 text-center">
        <span class="eyebrow text-brand mb-3">Help &amp; Support</span>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">How can we help?</h1>
        <p class="mt-3 text-slate-soft text-lg max-w-xl mx-auto">No call centres and no ticket queues. You deal directly with the engineer who knows your system.</p>
      </div>
    </section>

    <!-- Contact channels -->
    <section class="py-14 sm:py-16">
      <div class="container-x grid sm:grid-cols-3 gap-6">
        <a href="tel:07404636800" class="card p-7 text-center hover:border-brand transition-colors reveal">
          <span class="mx-auto grid place-items-center w-12 h-12 rounded-full bg-brand-tint text-brand mb-4"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.24 11.5 11.5 0 003.6.58 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.5 11.5 0 00.58 3.6 1 1 0 01-.24 1l-2.24 2.2z"/></svg></span>
          <h2 class="font-semibold">Call us</h2>
          <p class="text-sm text-slate-soft mt-1">07404 636800</p>
        </a>
        <a href="https://wa.me/447404636800" class="card p-7 text-center hover:border-brand transition-colors reveal reveal-delay-1">
          <span class="mx-auto grid place-items-center w-12 h-12 rounded-full bg-brand-tint text-brand mb-4"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1012 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.1c.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.5-.3.3c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.3.1.5.1.7-.1l.9-1c.2-.2.4-.2.6-.1l2 .9c.3.2.5.2.6.3.1.3.1.9-.1 1.4z"/></svg></span>
          <h2 class="font-semibold">WhatsApp us</h2>
          <p class="text-sm text-slate-soft mt-1">Quick replies, 7 days a week</p>
        </a>
        <a href="mailto:contact@suttonss.co.uk" class="card p-7 text-center hover:border-brand transition-colors reveal reveal-delay-2">
          <span class="mx-auto grid place-items-center w-12 h-12 rounded-full bg-brand-tint text-brand mb-4"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M2 6a2 2 0 012-2h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6zm2 .4V18h16V6.4l-8 5-8-5z"/></svg></span>
          <h2 class="font-semibold">Email us</h2>
          <p class="text-sm text-slate-soft mt-1">contact@suttonss.co.uk</p>
        </a>
      </div>
    </section>

    <!-- Common help topics -->
    <section class="py-14 sm:py-16 bg-gray-50">
      <div class="container-x max-w-3xl">
        <div class="text-center mb-10 reveal">
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight">Common questions</h2>
        </div>
        <div class="divide-y divide-black/10 border-y border-black/10 reveal reveal-delay-1">
          <%
            var faqs = [
              { q: 'My app is not showing my system', a: 'Check your phone has an internet connection, then close and reopen the Ajax app. If it still does not appear, call us and we will get you reconnected, it usually takes a couple of minutes.' },
              { q: 'A sensor shows a low battery warning', a: 'Ajax batteries last for years, but when one runs low the app will tell you well in advance. Call us and we will supply and fit the right replacement.' },
              { q: 'The alarm went off by accident', a: 'Disarm from your app or keypad. False alarms are rare, if it keeps happening we will visit and adjust the sensor placement free of charge.' },
              { q: 'I want to add more devices', a: 'Your hub supports 200+ devices, so extending is easy. Tell us what you want to cover and we will quote a one-off price for the extra kit and fitting.' },
              { q: 'I am moving house', a: 'Your system moves with you. Visit our Moving Home page or give us a call and we will arrange the uninstall and refit around your dates.' }
            ];
          %>
          <% faqs.forEach(function(f){ %>
            <details class="group py-5">
              <summary class="flex items-center justify-between cursor-pointer list-none font-semibold">
                <%= f.q %>
                <span class="ml-4 grid place-items-center w-8 h-8 rounded-full bg-brand-tint text-brand shrink-0 group-open:rotate-45 transition-transform">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </summary>
              <p class="mt-3 text-slate-soft leading-relaxed pr-10 text-sm"><%= f.a %></p>
            </details>
          <% }) %>
        </div>
        <p class="text-center text-sm text-slate-soft mt-8">Still stuck? Call <a href="tel:07404636800" class="text-brand font-semibold">07404 636800</a> and speak to your engineer directly.</p>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
